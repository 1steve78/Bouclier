{
  "application": {
    "name": "Bouclier",
    "version": "1.1.0-dev",
    "environment": "development"
  },
  "http_server": {
    "host": "127.0.0.1",
    "port": 8081,
    "read_header_timeout": "5s",
    "read_timeout": "15s",
    "write_timeout": "30s",
    "idle_timeout": "60s",
    "max_scan_duration": "20s"
  },
  "scanner": {
    "http_timeout": "8s",
    "tls_handshake_timeout": "5s",
    "max_redirects": 5,
    "max_concurrent_scans": 10,
    "user_agent": "Bouclier/1.1.0-dev"
  },
  "ai": {
    "enabled": false,
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "llama3.2"
    },
    "timeout": "90s",
    "max_tokens": 512
  },
  "storage": {
    "database_path": "~/.bouclier/bouclier.db",
    "cache_ttl": "24h"
  },
  "threat_intelligence": {
    "feed_update_interval": "24h",
    "feed_urls": []
  },
  "logging": {
    "level": "info",
    "structured": false
  }
}
